# Copy to .env for local development. Real values in production live only
# in Render's environment variable settings — never commit a filled-in .env.
ENVIRONMENT=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qassist

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BEDROCK_CLAUDE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

FRONTEND_ORIGIN=http://localhost:5173
